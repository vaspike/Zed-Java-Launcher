{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "request": {
      "type": "string",
      "enum": ["launch"],
      "description": "Request type for Java Launcher, always 'launch'."
    },
    "group": {
      "type": "string",
      "description": "Microservice group name to launch (defined in .java-launcher/config.json)."
    },
    "entry": {
      "type": "string",
      "description": "Specific microservice or application entry to launch."
    },
    "name": {
      "type": "string",
      "description": "Short name of the service or launch configuration."
    },
    "mainClass": {
      "type": "string",
      "description": "Fully qualified Java main class name."
    },
    "projectName": {
      "type": "string",
      "description": "Module or project name."
    },
    "cwd": {
      "type": "string",
      "description": "Working directory for the process."
    },
    "vmArgs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "JVM arguments."
    },
    "args": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Program arguments."
    },
    "env": {
      "type": "object",
      "description": "Environment variables."
    },
    "console": {
      "type": "string",
      "description": "Console type (e.g. integratedTerminal)."
    },
    "stopOnEntry": {
      "type": "boolean",
      "description": "Whether to pause at main entry."
    },
    "skipBuild": {
      "type": "boolean",
      "description": "Skip compilation step when launching."
    },
    "debugPort": {
      "type": "integer",
      "description": "Optional JDWP debug port to open for the Java process."
    }
  },
  "required": ["request"]
}
